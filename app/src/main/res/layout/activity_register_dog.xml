<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_register_dog.xml
  Registro del perro del dueño. Parte del onboarding.
  IDs: etDogName, etBreed, spinnerSize, etAge, etAllergy, btnSaveDog
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header con ilustración de perro -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:background="@color/primary_dark">

            <!-- Fondo decorativo -->
            <View
                android:layout_width="360dp"
                android:layout_height="360dp"
                android:layout_gravity="bottom|end"
                android:layout_marginBottom="-180dp"
                android:layout_marginEnd="-80dp"
                android:background="@drawable/circle_primary_light"
                android:alpha="0.25"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:paddingStart="28dp"
                android:paddingBottom="20dp">

                <!-- Emoji de perro grande -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🐕"
                    android:textSize="56sp"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dog_title"
                    android:textColor="@color/surface"
                    android:textSize="24sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dog_subtitle"
                    android:textColor="#CCFFFFFF"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </FrameLayout>

        <!-- Formulario del perro -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_margin"
            android:paddingEnd="@dimen/page_margin"
            android:paddingTop="28dp"
            android:paddingBottom="32dp">

            <!-- Nombre del perro -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilDogName"
                style="@style/Widget.DogWalk.TextInputLayout"
                android:hint="@string/hint_dog_name">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDogName"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:inputType="textPersonName"
                    android:imeOptions="actionNext"/>
            </com.google.android.material.textfield.TextInputLayout>

            <Space android:layout_width="match_parent" android:layout_height="12dp"/>

            <!-- Raza -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilBreed"
                style="@style/Widget.DogWalk.TextInputLayout"
                android:hint="@string/hint_breed">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etBreed"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:inputType="textCapSentences"
                    android:imeOptions="actionNext"/>
            </com.google.android.material.textfield.TextInputLayout>

            <Space android:layout_width="match_parent" android:layout_height="12dp"/>

            <!-- Edad -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilAge"
                style="@style/Widget.DogWalk.TextInputLayout"
                android:hint="@string/hint_age">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etAge"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:inputType="number"
                    android:imeOptions="actionNext"/>
            </com.google.android.material.textfield.TextInputLayout>

            <Space android:layout_width="match_parent" android:layout_height="20dp"/>

            <!-- Tamaño del perro -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_size"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginBottom="10dp"/>

            <!-- Selector de tamaño como chips -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="🐩 Pequeño"
                    android:textSize="14sp"
                    android:checkable="true"
                    app:chipBackgroundColor="@color/surface"
                    app:chipStrokeColor="@color/border"
                    app:chipStrokeWidth="1.5dp"
                    app:checkedIconTint="@color/primary"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="🐕 Mediano"
                    android:textSize="14sp"
                    android:checkable="true"
                    app:chipBackgroundColor="@color/surface"
                    app:chipStrokeColor="@color/border"
                    app:chipStrokeWidth="1.5dp"
                    app:checkedIconTint="@color/primary"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="🦮 Grande"
                    android:textSize="14sp"
                    android:checkable="true"
                    app:chipBackgroundColor="@color/surface"
                    app:chipStrokeColor="@color/border"
                    app:chipStrokeWidth="1.5dp"
                    app:checkedIconTint="@color/primary"/>
            </com.google.android.material.chip.ChipGroup>

            <!-- Spinner oculto para compatibilidad con el Kotlin del dueño -->
            <Spinner
                android:id="@+id/spinnerSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"/>

            <Space android:layout_width="match_parent" android:layout_height="20dp"/>

            <!-- Alergias -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilAllergy"
                style="@style/Widget.DogWalk.TextInputLayout"
                android:hint="@string/hint_allergy">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etAllergy"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:inputType="textCapSentences"
                    android:imeOptions="actionDone"/>
            </com.google.android.material.textfield.TextInputLayout>

            <Space android:layout_width="match_parent" android:layout_height="28dp"/>

            <!-- Botón guardar -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveDog"
                style="@style/Widget.DogWalk.Button.Primary"
                android:text="@string/btn_save_dog"/>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
