<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_register_dog.xml
  IDs: etDogName, etBreed, chipGroupSize, chipSmall, chipMedium,
       chipLarge, etAge, etAllergy, btnSaveDog
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Toolbar con botón back -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary_dark"
        app:titleTextColor="@color/surface"
        app:navigationIconTint="@color/surface"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:background="@color/primary_dark">

                <View
                    android:layout_width="360dp"
                    android:layout_height="360dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginBottom="-180dp"
                    android:layout_marginEnd="-80dp"
                    android:background="@drawable/circle_primary_light"
                    android:alpha="0.25"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:paddingStart="28dp"
                    android:paddingBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🐕"
                        android:textSize="48sp"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cuéntanos sobre tu perro"
                        android:textColor="@color/surface"
                        android:textSize="22sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tu compañero de aventuras"
                        android:textColor="#CCFFFFFF"
                        android:textSize="13sp"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </FrameLayout>

            <!-- Formulario -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="24dp"
                android:paddingBottom="32dp">

                <!-- Nombre del perro -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilDogName"
                    style="@style/Widget.DogWalk.TextInputLayout"
                    android:hint="Nombre del perro">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDogName"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:inputType="textPersonName"
                        android:imeOptions="actionNext"/>
                </com.google.android.material.textfield.TextInputLayout>

                <Space android:layout_width="match_parent" android:layout_height="12dp"/>

                <!-- Raza -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilBreed"
                    style="@style/Widget.DogWalk.TextInputLayout"
                    android:hint="Raza">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etBreed"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:inputType="textCapSentences"
                        android:imeOptions="actionNext"/>
                </com.google.android.material.textfield.TextInputLayout>

                <Space android:layout_width="match_parent" android:layout_height="12dp"/>

                <!-- Edad -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilAge"
                    style="@style/Widget.DogWalk.TextInputLayout"
                    android:hint="Edad (años)">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etAge"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:inputType="number"
                        android:imeOptions="actionNext"/>
                </com.google.android.material.textfield.TextInputLayout>

                <Space android:layout_width="match_parent" android:layout_height="20dp"/>

                <!-- Tamaño -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tamaño del perro"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:layout_marginBottom="10dp"/>

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupSize"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="🐩 Pequeño"
                        android:textSize="14sp"
                        android:checkable="true"
                        app:chipBackgroundColor="@color/surface"
                        app:chipStrokeColor="@color/border"
                        app:chipStrokeWidth="1.5dp"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="🐕 Mediano"
                        android:textSize="14sp"
                        android:checkable="true"
                        app:chipBackgroundColor="@color/surface"
                        app:chipStrokeColor="@color/border"
                        app:chipStrokeWidth="1.5dp"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipLarge"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="🦮 Grande"
                        android:textSize="14sp"
                        android:checkable="true"
                        app:chipBackgroundColor="@color/surface"
                        app:chipStrokeColor="@color/border"
                        app:chipStrokeWidth="1.5dp"/>
                </com.google.android.material.chip.ChipGroup>

                <Space android:layout_width="match_parent" android:layout_height="20dp"/>

                <!-- Alergias -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilAllergy"
                    style="@style/Widget.DogWalk.TextInputLayout"
                    android:hint="Alergias (opcional)">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etAllergy"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:inputType="textCapSentences"
                        android:imeOptions="actionDone"/>
                </com.google.android.material.textfield.TextInputLayout>

                <Space android:layout_width="match_parent" android:layout_height="28dp"/>

                <!-- Botón guardar -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveDog"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    app:cornerRadius="100dp"
                    android:backgroundTint="@color/primary"
                    android:textColor="@color/surface"
                    android:text="Guardar y continuar"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"/>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>