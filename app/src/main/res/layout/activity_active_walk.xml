<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_active_walk.xml
  Pantalla del PASEADOR durante el paseo.
  IDs: tvStatus, tvDogInfo, tvWalkCost, btnStartWalk, btnFinishWalk
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Header verde paseador -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:background="@color/accent">

        <View
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="-80dp"
            android:layout_marginEnd="-60dp"
            android:background="@drawable/circle_white_alpha"
            android:alpha="0.15"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🦺 Modo paseador"
                android:textColor="#AAFFFFFF"
                android:textSize="13sp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¡Listo para iniciar!"
                android:textColor="@color/surface"
                android:textSize="24sp"
                android:textStyle="bold"/>

        </LinearLayout>
    </FrameLayout>

    <!-- Contenido -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="32dp">

            <!-- Tarjeta info del perro -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/surface"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🐕"
                            android:textSize="36sp"
                            android:layout_marginEnd="12dp"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tu peludo de hoy"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"/>

                            <TextView
                                android:id="@+id/tvDogInfo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Rex • Labrador • Grande"
                                android:textColor="@color/text_primary"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider"
                        android:layout_marginBottom="12dp"/>

                    <!-- Costo -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="💵"
                            android:textSize="20sp"
                            android:layout_marginEnd="8dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ganancia estimada:"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp"
                            android:layout_marginEnd="8dp"/>

                        <TextView
                            android:id="@+id/tvWalkCost"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="$15.00 • 30 min"
                            android:textColor="@color/accent"
                            android:textSize="15sp"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Tarjeta de consejos -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/surface_alt"
                android:layout_marginBottom="32dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💡"
                        android:textSize="22sp"
                        android:layout_marginEnd="12dp"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Recuerda llevar bolsas y agua para el perro durante el paseo"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:lineSpacingMultiplier="1.3"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Botón iniciar -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStartWalk"
                style="@style/Widget.DogWalk.Button.Success"
                android:text="🐾 ¡Iniciar paseo!"
                android:layout_marginBottom="12dp"/>

            <!-- Botón finalizar -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFinishWalk"
                style="@style/Widget.DogWalk.Button.Primary"
                android:text="🏁 Finalizar paseo"
                android:enabled="false"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
