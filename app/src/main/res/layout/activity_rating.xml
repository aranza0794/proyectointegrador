<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_rating.xml
  IDs: toolbar, tvRatingLabel, ratingBar, etComment,
       btnSubmitRating, btnSkip
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Toolbar sin back — flujo obligatorio -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary"
        app:title="Calificar paseo"
        app:titleTextColor="@color/surface"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="32dp"
            android:paddingBottom="32dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginBottom="28dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⭐"
                    android:textSize="56sp"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="¿Cómo fue el paseo?"
                    android:textColor="@color/text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- Tarjeta con estrellas -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/surface"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="28dp"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvRatingLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Toca las estrellas para calificar"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        android:layout_marginBottom="20dp"/>

                    <RatingBar
                        android:id="@+id/ratingBar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:numStars="5"
                        android:rating="0"
                        android:stepSize="1"
                        style="@style/Widget.AppCompat.RatingBar"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Comentario -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilComment"
                style="@style/Widget.DogWalk.TextInputLayout"
                android:hint="Deja un comentario (opcional)"
                android:layout_marginBottom="28dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etComment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="100dp"
                    android:inputType="textMultiLine|textCapSentences"
                    android:gravity="top"
                    android:maxLines="5"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Botón enviar -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmitRating"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                app:cornerRadius="100dp"
                android:backgroundTint="@color/primary"
                android:textColor="@color/surface"
                android:text="Enviar calificación"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:layout_marginBottom="12dp"/>

            <!-- Botón omitir -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSkip"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                app:cornerRadius="100dp"
                android:backgroundTint="@color/surface_alt"
                android:textColor="@color/text_secondary"
                android:text="Omitir"
                android:textSize="15sp"
                android:textAllCaps="false"
                app:strokeColor="@color/border"
                app:strokeWidth="1dp"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>