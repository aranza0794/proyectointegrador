<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary"
        app:title="Calificar paseo"
        app:titleTextColor="#FFFFFF"/>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Huellas fondo grandes -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="🐾" android:textSize="100sp" android:alpha="0.05"
            android:layout_gravity="top|start" android:layout_marginTop="10dp"
            android:layout_marginStart="-20dp" android:rotation="-15"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="🐾" android:textSize="80sp" android:alpha="0.05"
            android:layout_gravity="top|end" android:layout_marginTop="120dp"
            android:layout_marginEnd="-15dp" android:rotation="20"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="🦴" android:textSize="60sp" android:alpha="0.06"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="100dp" android:rotation="10"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="24dp"
                android:paddingBottom="32dp">

                <!-- Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginBottom="24dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_marginBottom="12dp"
                        app:cardCornerRadius="40dp"
                        app:cardElevation="6dp"
                        app:cardBackgroundColor="@color/primary_ultra_light"
                        app:strokeColor="@color/primary"
                        app:strokeWidth="2dp">
                        <TextView android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center" android:text="🐾" android:textSize="36sp"/>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="¿Cómo fue el paseo?"
                        android:textColor="#1A1A1A"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins"/>

                    <TextView
                        android:id="@+id/tvRatingLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Toca las huellas para calificar"
                        android:textColor="#888888"
                        android:textSize="14sp"
                        android:fontFamily="@font/poppins"
                        android:layout_marginTop="6dp"/>
                </LinearLayout>

                <!-- Tarjeta huellas -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="6dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:strokeColor="@color/primary_ultra_light"
                    app:strokeWidth="2dp"
                    android:layout_marginBottom="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="28dp"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tu calificación"
                            android:textColor="#AAAAAA"
                            android:textSize="13sp"
                            android:fontFamily="@font/poppins"
                            android:layout_marginBottom="20dp"/>

                        <!-- 5 huellas -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center">

                            <TextView android:id="@+id/paw1"
                                android:layout_width="52dp" android:layout_height="52dp"
                                android:gravity="center" android:text="🐾" android:textSize="36sp"
                                android:alpha="0.25" android:clickable="true" android:focusable="true" android:padding="2dp"/>
                            <TextView android:id="@+id/paw2"
                                android:layout_width="52dp" android:layout_height="52dp"
                                android:gravity="center" android:text="🐾" android:textSize="36sp"
                                android:alpha="0.25" android:clickable="true" android:focusable="true" android:padding="2dp"/>
                            <TextView android:id="@+id/paw3"
                                android:layout_width="52dp" android:layout_height="52dp"
                                android:gravity="center" android:text="🐾" android:textSize="36sp"
                                android:alpha="0.25" android:clickable="true" android:focusable="true" android:padding="2dp"/>
                            <TextView android:id="@+id/paw4"
                                android:layout_width="52dp" android:layout_height="52dp"
                                android:gravity="center" android:text="🐾" android:textSize="36sp"
                                android:alpha="0.25" android:clickable="true" android:focusable="true" android:padding="2dp"/>
                            <TextView android:id="@+id/paw5"
                                android:layout_width="52dp" android:layout_height="52dp"
                                android:gravity="center" android:text="🐾" android:textSize="36sp"
                                android:alpha="0.25" android:clickable="true" android:focusable="true" android:padding="2dp"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Comentario -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilComment"
                    style="@style/Widget.DogWalk.TextInputLayout"
                    android:hint="Deja un comentario (opcional) 🐶"
                    android:layout_marginBottom="24dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etComment"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="100dp"
                        android:inputType="textMultiLine|textCapSentences"
                        android:gravity="top"
                        android:textColor="#1A1A1A"
                        android:fontFamily="@font/poppins"
                        android:maxLines="5"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSubmitRating"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    app:cornerRadius="28dp"
                    android:backgroundTint="@color/primary"
                    android:textColor="#FFFFFF"
                    android:text="🐾  Enviar calificación"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins"
                    android:textAllCaps="false"
                    android:layout_marginBottom="12dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSkip"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    app:cornerRadius="26dp"
                    android:backgroundTint="@color/surface_alt"
                    android:textColor="#888888"
                    android:text="Omitir por ahora"
                    android:textSize="14sp"
                    android:fontFamily="@font/poppins"
                    android:textAllCaps="false"/>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>