<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_splash.xml
  Pantalla de carga inicial. Muestra el logo y nombre de la app
  mientras se verifica si el usuario ya tiene sesión activa.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary">

    <!-- Círculo decorativo superior derecho -->
    <View
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-60dp"
        android:layout_marginEnd="-60dp"
        android:background="@drawable/circle_primary_light"
        android:alpha="0.3"/>

    <!-- Círculo decorativo inferior izquierdo -->
    <View
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="-40dp"
        android:layout_marginStart="-40dp"
        android:background="@drawable/circle_primary_light"
        android:alpha="0.2"/>

    <!-- Contenido central -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Ícono de la pata del perro (usa un emoji o drawable) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🐾"
            android:textSize="80sp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Patitas en Ruta"
            android:textColor="@color/surface"
            android:textSize="42sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tu paseo, nuestra misión"
            android:textColor="#CCFFFFFF"
            android:textSize="15sp"
            android:layout_marginTop="8dp"
            android:letterSpacing="0.02"/>

    </LinearLayout>

    <!-- Indicador de carga en la parte inferior -->
    <ProgressBar
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="60dp"
        android:indeterminateTint="@color/surface"/>

</FrameLayout>
