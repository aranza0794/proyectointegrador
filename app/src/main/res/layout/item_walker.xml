<?xml version="1.0" encoding="utf-8"?>
<!--
  item_walker.xml
  IDs: ivWalkerPhoto, tvWalkerInitial, tvWalkerName, tvWalkerRating,
       ratingBarWalker, tvWalkerRatingCount, tvWalkerCard, tvWalkerPrice, btnSelectWalker
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="5dp"
    app:cardBackgroundColor="#FFFFFF"
    app:strokeColor="@color/primary_ultra_light"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Fila: foto + info + precio -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp"
            android:baselineAligned="false">

            <!-- Foto con punto verde de disponibilidad -->
            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginEnd="14dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    app:cardCornerRadius="32dp"
                    app:cardElevation="3dp"
                    app:cardBackgroundColor="@color/primary_ultra_light">
                    <ImageView
                        android:id="@+id/ivWalkerPhoto"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:visibility="gone"/>
                    <TextView
                        android:id="@+id/tvWalkerInitial"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="\?"
                        android:textColor="@color/primary"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins"/>
                </com.google.android.material.card.MaterialCardView>

                <!-- Punto verde disponible -->
                <View
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/circle_green_online"/>
            </FrameLayout>

            <!-- Nombre y calificación -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvWalkerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#1A1A1A"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <RatingBar
                        android:id="@+id/ratingBarWalker"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:numStars="5"
                        android:rating="0"
                        android:isIndicator="true"
                        android:progressTint="@color/accent"
                        style="@style/Widget.AppCompat.RatingBar.Small"/>

                    <TextView
                        android:id="@+id/tvWalkerRating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.0"
                        android:textColor="#666666"
                        android:textSize="12sp"
                        android:fontFamily="@font/poppins"
                        android:layout_marginStart="4dp"/>

                    <TextView
                        android:id="@+id/tvWalkerRatingCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#AAAAAA"
                        android:textSize="11sp"
                        android:fontFamily="@font/poppins"
                        android:layout_marginStart="2dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Badge precio naranja -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/badge_accent"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">
                <TextView
                    android:id="@+id/tvWalkerPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$1"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="por min"
                    android:textColor="#EEFFFFFF"
                    android:textSize="10sp"
                    android:fontFamily="@font/poppins"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Separador -->
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/divider" android:layout_marginBottom="12dp"/>

        <!-- Tarjeta -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp"
            android:baselineAligned="false">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="10dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/primary_ultra_light">
                <TextView android:layout_width="match_parent" android:layout_height="match_parent"
                    android:gravity="center" android:text="💳" android:textSize="18sp"/>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Tarjeta de cobro"
                    android:textColor="#AAAAAA" android:textSize="11sp" android:fontFamily="@font/poppins"/>
                <TextView
                    android:id="@+id/tvWalkerCard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="**** **** **** ----"
                    android:textColor="#1A1A1A"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Botón seleccionar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSelectWalker"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            app:cornerRadius="24dp"
            android:backgroundTint="@color/primary"
            android:textColor="#FFFFFF"
            android:text="🐾  Seleccionar paseador"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="@font/poppins"
            android:textAllCaps="false"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>