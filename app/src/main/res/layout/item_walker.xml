<?xml version="1.0" encoding="utf-8"?>
<!--
  item_walker.xml
  IDs: ivWalkerPhoto, tvWalkerInitial, tvWalkerName, tvWalkerRating,
       ratingBarWalker, tvWalkerRatingCount, tvWalkerCard, tvWalkerPrice, btnSelectWalker
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Fila superior: foto + info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false"
            android:layout_marginBottom="12dp">

            <!-- FIX: Foto del paseador -->
            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginEnd="14dp">

                <!-- Foto real (visible si tiene foto) -->
                <ImageView
                    android:id="@+id/ivWalkerPhoto"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:scaleType="centerCrop"
                    android:visibility="gone"/>

                <!-- Inicial del nombre (visible si no tiene foto) -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/primary_ultra_light">

                    <TextView
                        android:id="@+id/tvWalkerInitial"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="?"
                        android:textColor="@color/primary"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins"/>
                </com.google.android.material.card.MaterialCardView>
            </FrameLayout>

            <!-- Nombre y calificación -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvWalkerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins"/>

                <!-- Estrellas + número -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <RatingBar
                        android:id="@+id/ratingBarWalker"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:numStars="5"
                        android:rating="0"
                        android:isIndicator="true"
                        android:progressTint="@color/primary"
                        style="@style/Widget.AppCompat.RatingBar.Small"/>

                    <TextView
                        android:id="@+id/tvWalkerRating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.0"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:fontFamily="@font/poppins"
                        android:layout_marginStart="4dp"/>

                    <TextView
                        android:id="@+id/tvWalkerRatingCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/text_hint"
                        android:textSize="11sp"
                        android:fontFamily="@font/poppins"
                        android:layout_marginStart="2dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Precio por minuto -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvWalkerPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$1"
                    android:textColor="@color/primary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="por min"
                    android:textColor="@color/text_hint"
                    android:textSize="10sp"
                    android:fontFamily="@font/poppins"
                    android:gravity="center"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Separador -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginBottom="12dp"/>

        <!-- FIX: Número de tarjeta (últimos 4 dígitos) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp"
            android:baselineAligned="false">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="10dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/surface_alt">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="💳"
                    android:textSize="16sp"/>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tarjeta de cobro"
                    android:textColor="@color/text_hint"
                    android:textSize="11sp"
                    android:fontFamily="@font/poppins"/>

                <TextView
                    android:id="@+id/tvWalkerCard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="**** **** **** ----"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins"
                    android:letterSpacing="0.05"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Botón seleccionar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSelectWalker"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            app:cornerRadius="100dp"
            android:backgroundTint="@color/primary"
            android:textColor="@color/surface"
            android:text="Seleccionar paseador"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="@font/poppins"
            android:textAllCaps="false"/>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>