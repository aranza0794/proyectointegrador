<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_request_walk.xml
  IDs: toolbar, chipGroupDogs, tvDogName, tvDogBreed, cardDogInfo,
       btn30, btn45, btn60, btn90, tvCustomDuration, tvPrice,
       chipCash, chipTransfer, btnRequestWalk
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Header -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:background="@color/primary">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="top|end" android:layout_marginTop="10dp" android:layout_marginEnd="16dp"
            android:text="🐾" android:textSize="28sp" android:alpha="0.18" android:rotation="20"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="bottom|start" android:layout_marginBottom="16dp" android:layout_marginStart="170dp"
            android:text="🦴" android:textSize="18sp" android:alpha="0.15" android:rotation="30"/>

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            app:titleTextColor="#FFFFFF"
            app:navigationIconTint="#FFFFFF"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:paddingStart="20dp"
            android:paddingBottom="14dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Solicitar paseo 🐕"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins"/>
        </LinearLayout>
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="32dp">

            <!-- Selección de perro -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="🐕" android:textSize="20sp" android:layout_marginEnd="8dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="¿Cuál perro va al paseo?"
                            android:textColor="#1A1A1A" android:textSize="15sp" android:textStyle="bold"
                            android:fontFamily="@font/poppins"/>
                    </LinearLayout>

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupDogs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:singleSelection="true"
                        app:selectionRequired="true"/>

                    <!-- Info del perro seleccionado -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardDogInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:visibility="gone"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/primary_ultra_light">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="12dp"
                            android:gravity="center_vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="🐾" android:textSize="20sp" android:layout_marginEnd="10dp"/>
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:orientation="vertical">
                                <TextView android:id="@+id/tvDogName"
                                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="" android:textColor="@color/primary"
                                    android:textSize="14sp" android:textStyle="bold"
                                    android:fontFamily="@font/poppins"/>
                                <TextView android:id="@+id/tvDogBreed"
                                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="" android:textColor="#666666"
                                    android:textSize="12sp" android:fontFamily="@font/poppins"/>
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Duración con botones predefinidos -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="14dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="⏱" android:textSize="20sp" android:layout_marginEnd="8dp"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Duración del paseo"
                            android:textColor="#1A1A1A" android:textSize="15sp" android:textStyle="bold"
                            android:fontFamily="@font/poppins"/>
                        <!-- Precio dinámico -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/badge_accent"
                            android:paddingStart="10dp" android:paddingEnd="10dp"
                            android:paddingTop="4dp" android:paddingBottom="4dp">
                            <TextView
                                android:id="@+id/tvPrice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="$30"
                                android:textColor="#FFFFFF"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/poppins"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Botones de tiempo predefinidos -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn30"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            app:cornerRadius="16dp"
                            android:backgroundTint="@color/primary"
                            android:textColor="#FFFFFF"
                            android:text="30\nmin"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins"
                            android:textAllCaps="false"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn45"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            app:cornerRadius="16dp"
                            android:backgroundTint="@color/surface_alt"
                            android:textColor="#666666"
                            android:text="45\nmin"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins"
                            android:textAllCaps="false"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn60"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            app:cornerRadius="16dp"
                            android:backgroundTint="@color/surface_alt"
                            android:textColor="#666666"
                            android:text="60\nmin"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins"
                            android:textAllCaps="false"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn90"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            app:cornerRadius="16dp"
                            android:backgroundTint="@color/surface_alt"
                            android:textColor="#666666"
                            android:text="90\nmin"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins"
                            android:textAllCaps="false"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvCustomDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="30 minutos seleccionados · $30 MXN"
                        android:textColor="@color/primary"
                        android:textSize="13sp"
                        android:fontFamily="@font/poppins"
                        android:layout_marginTop="10dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Método de pago -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="💳" android:textSize="20sp" android:layout_marginEnd="8dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Método de pago"
                            android:textColor="#1A1A1A" android:textSize="15sp" android:textStyle="bold"
                            android:fontFamily="@font/poppins"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/chipCash"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            app:cornerRadius="16dp"
                            android:backgroundTint="@color/primary"
                            android:textColor="#FFFFFF"
                            android:text="💵 Efectivo"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins"
                            android:textAllCaps="false"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/chipTransfer"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            app:cornerRadius="16dp"
                            android:backgroundTint="@color/surface_alt"
                            android:textColor="#666666"
                            android:text="🏦 Transferencia"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins"
                            android:textAllCaps="false"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRequestWalk"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                app:cornerRadius="29dp"
                android:backgroundTint="@color/primary"
                android:textColor="#FFFFFF"
                android:text="🐾  Buscar paseador"
                android:textSize="17sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins"
                android:textAllCaps="false"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>