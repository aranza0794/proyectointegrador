<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_login.xml
  Pantalla de inicio de sesión.
  IDs: etEmail, etPassword, btnLogin, tvGoRegister
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header con curva naranja -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:background="@color/primary">

            <!-- Onda decorativa (círculo grande cortado) -->
            <View
                android:layout_width="500dp"
                android:layout_height="500dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="-280dp"
                android:background="@drawable/circle_background"/>

            <!-- Contenido del header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:paddingStart="28dp"
                android:paddingBottom="32dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🐾"
                    android:textSize="44sp"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_title"
                    android:textColor="@color/surface"
                    android:textSize="30sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_subtitle"
                    android:textColor="#CCFFFFFF"
                    android:textSize="15sp"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </FrameLayout>

        <!-- Formulario -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_margin"
            android:paddingEnd="@dimen/page_margin"
            android:paddingTop="32dp"
            android:paddingBottom="32dp">

            <!-- Campo email -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilEmail"
                style="@style/Widget.DogWalk.TextInputLayout"
                android:hint="@string/hint_email"
                app:startIconDrawable="@android:drawable/ic_dialog_email"
                app:startIconTint="@color/primary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:inputType="textEmailAddress"
                    android:imeOptions="actionNext"/>
            </com.google.android.material.textfield.TextInputLayout>

            <Space android:layout_width="match_parent" android:layout_height="16dp"/>

            <!-- Campo contraseña -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPassword"
                style="@style/Widget.DogWalk.TextInputLayout"
                android:hint="@string/hint_password"
                app:startIconDrawable="@android:drawable/ic_lock_lock"
                app:startIconTint="@color/primary"
                app:endIconMode="password_toggle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:inputType="textPassword"
                    android:imeOptions="actionDone"/>
            </com.google.android.material.textfield.TextInputLayout>

            <Space android:layout_width="match_parent" android:layout_height="28dp"/>

            <!-- Botón iniciar sesión -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogin"
                style="@style/Widget.DogWalk.Button.Primary"
                android:text="@string/btn_login"/>

            <Space android:layout_width="match_parent" android:layout_height="20dp"/>

            <!-- Ir a registro -->
            <TextView
                android:id="@+id/tvGoRegister"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/go_register"
                style="@style/Widget.DogWalk.Text.Link"
                android:padding="8dp"/>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
