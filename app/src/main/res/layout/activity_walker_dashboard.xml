<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_walker_dashboard.xml
  IDs: tvWelcome, rvPendingRequests, btnLogout, switchAvailable,
       tvAvailableStatus, tvRequestCount, layoutEmpty
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Header verde -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:background="@color/accent">

        <View
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="-60dp"
            android:layout_marginEnd="-60dp"
            android:background="@drawable/circle_white_alpha"
            android:alpha="0.15"/>

        <!-- FIX: 40dp → 48dp para touch target mínimo -->
        <ImageButton
            android:id="@+id/btnLogout"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:background="@drawable/circle_white_20"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/accent"
            android:contentDescription="Cerrar sesión"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🦺 Modo Paseador"
                android:textColor="#AAFFFFFF"
                android:textSize="13sp"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:id="@+id/tvWelcome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/surface"
                android:textSize="28sp"
                android:textStyle="bold"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="10dp">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchAvailable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:thumbTint="@color/surface"
                    android:trackTint="#80FFFFFF"/>

                <!-- FIX: hardcoded text → string vacío, el KT lo asigna -->
                <TextView
                    android:id="@+id/tvAvailableStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#CCFFFFFF"
                    android:textSize="13sp"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Sección de solicitudes -->
    <!-- FIX: Nested layout weights — se elimina el layout_weight del hijo
         layoutEmpty para evitar doble peso anidado. Se usa un solo
         FrameLayout contenedor que alterna visibilidad entre
         layoutEmpty y rvPendingRequests -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Encabezado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="8dp"
            android:gravity="center_vertical"
            android:baselineAligned="false">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Solicitudes pendientes"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <!-- FIX: textColor → surface (blanco) sobre fondo primary para contraste -->
            <TextView
                android:id="@+id/tvRequestCount"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:gravity="center"
                android:text="0"
                android:textColor="@color/surface"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/circle_primary"/>
        </LinearLayout>

        <!-- FIX: FrameLayout reemplaza los dos hijos con layout_weight anidado
             Solo uno es visible a la vez: layoutEmpty o rvPendingRequests -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- Estado vacío -->
            <LinearLayout
                android:id="@+id/layoutEmpty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone"
                android:padding="32dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🐾"
                    android:textSize="56sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sin solicitudes"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginTop="16dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Las nuevas solicitudes aparecerán aquí"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>

            <!-- Lista de solicitudes -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPendingRequests"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="24dp"/>

        </FrameLayout>
    </LinearLayout>
</LinearLayout>