<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_paws">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:background="@color/primary">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="top|end" android:layout_marginTop="20dp" android:layout_marginEnd="16dp"
            android:text="🐾" android:textSize="32sp" android:alpha="0.2" android:rotation="20"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center|end" android:layout_marginEnd="30dp"
            android:text="🐾" android:textSize="20sp" android:alpha="0.15" android:rotation="-10"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="bottom|start" android:layout_marginBottom="20dp" android:layout_marginStart="180dp"
            android:text="🦴" android:textSize="20sp" android:alpha="0.15" android:rotation="30"/>

        <!-- Botón perfil — LinearLayout -->
        <LinearLayout
            android:id="@+id/btnLogout"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="40dp"
            android:layout_marginEnd="16dp"
            android:gravity="center"
            android:background="@drawable/circle_white_20"
            android:clickable="true"
            android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="👤" android:textSize="24sp"/>
        </LinearLayout>

        <!-- Info paseador -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="bottom"
            android:paddingStart="24dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/badge_accent"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:gravity="center"
                android:layout_marginBottom="6dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🦺 Modo paseador"
                    android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold"
                    android:fontFamily="@font/poppins"/>
            </LinearLayout>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Hola,"
                android:textColor="#CCFFFFFF" android:textSize="18sp" android:fontFamily="@font/poppins"/>

            <TextView
                android:id="@+id/tvWelcome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Patitas en Ruta"
                android:textColor="#AAFFFFFF" android:textSize="12sp"
                android:fontFamily="@font/poppins" android:layout_marginTop="2dp"
                android:layout_marginBottom="12dp"/>

            <!-- Switch disponibilidad -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchAvailable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:thumbTint="#FFFFFF"
                    android:trackTint="#80FFFFFF"/>

                <TextView
                    android:id="@+id/tvAvailableStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Disponible para paseos"
                    android:textColor="#EEFFFFFF"
                    android:textSize="13sp"
                    android:fontFamily="@font/poppins"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

            <!-- Botón historial -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWalkerHistory"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="12dp"
                app:cornerRadius="20dp"
                android:backgroundTint="#FFFFFF"
                android:textColor="@color/primary"
                android:text="📋 Mi historial"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins"
                android:textAllCaps="false"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"/>
        </LinearLayout>
    </FrameLayout>

    <!-- Solicitudes pendientes -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="8dp"
            android:gravity="center_vertical"
            android:baselineAligned="false">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Solicitudes pendientes"
                android:textColor="#1A1A1A"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="32dp"
                android:layout_height="32dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/primary">
                <TextView
                    android:id="@+id/tvRequestCount"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins"/>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/layoutEmpty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone"
                android:padding="32dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🐾" android:textSize="64sp" android:layout_marginBottom="16dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Sin solicitudes aún"
                    android:textColor="#1A1A1A" android:textSize="20sp" android:textStyle="bold"
                    android:fontFamily="@font/poppins" android:gravity="center"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Las nuevas solicitudes aparecerán aquí 🦴"
                    android:textColor="#666666" android:textSize="14sp"
                    android:fontFamily="@font/poppins" android:gravity="center"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPendingRequests"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="24dp"/>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>