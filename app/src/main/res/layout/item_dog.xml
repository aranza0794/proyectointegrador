<?xml version="1.0" encoding="utf-8"?>
<!--
  item_dog.xml
  IDs: ivDogPhoto, tvDogInitial, tvDogName, tvDogBreed, tvDogSize, tvDogAge, btnEditDog
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="#FFFFFF"
    app:strokeColor="#FFD080"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:baselineAligned="false">

        <!-- Foto del perro -->
        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginEnd="14dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="64dp"
                android:layout_height="64dp"
                app:cardCornerRadius="32dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFF3D6">
                <ImageView
                    android:id="@+id/ivDogPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone"/>
                <TextView
                    android:id="@+id/tvDogInitial"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="🐕"
                    android:textSize="28sp"/>
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>

        <!-- Info del perro -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDogName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#1A1A1A"
                android:textSize="17sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins"/>

            <TextView
                android:id="@+id/tvDogBreed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#777777"
                android:textSize="13sp"
                android:fontFamily="@font/poppins"
                android:layout_marginTop="2dp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#FFF3D6">
                    <TextView
                        android:id="@+id/tvDogSize"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#E8920A"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"/>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#E8F5E9">
                    <TextView
                        android:id="@+id/tvDogAge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#388E3C"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"/>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>

        <!-- Botón editar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditDog"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            app:cornerRadius="18dp"
            android:backgroundTint="#F5A623"
            android:textColor="#FFFFFF"
            android:text="Ver"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="@font/poppins"
            android:textAllCaps="false"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>