<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary"
        app:titleTextColor="@color/surface"
        app:navigationIconTint="@color/surface"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingTop="@dimen/spacing_lg"
            android:paddingBottom="@dimen/spacing_xxl">

            <!-- Título -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Crear cuenta"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_xxl"
                android:textStyle="bold"
                android:fontFamily="@font/poppins"
                android:layout_marginBottom="@dimen/spacing_xs"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Completa tus datos para registrarte"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_sm"
                android:fontFamily="@font/poppins"
                android:layout_marginBottom="@dimen/spacing_lg"/>

            <!-- Tipo de usuario -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/card_radius"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/surface"
                android:layout_marginBottom="@dimen/spacing_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="¿Cómo quieres usar DogWalk?"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_sm"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins"
                        android:layout_marginBottom="@dimen/spacing_sm"/>

                    <RadioGroup
                        android:id="@+id/rgUserType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/rbOwner"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:text="🐶 Soy dueño"
                            android:checked="true"
                            android:textSize="@dimen/text_sm"
                            android:fontFamily="@font/poppins"/>

                        <RadioButton
                            android:id="@+id/rbWalker"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:text="🦺 Soy paseador"
                            android:textSize="@dimen/text_sm"
                            android:fontFamily="@font/poppins"/>
                    </RadioGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Sección datos personales -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DATOS PERSONALES"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_xs"
                android:letterSpacing="0.12"
                android:fontFamily="@font/poppins"
                android:layout_marginBottom="@dimen/spacing_sm"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilFirstName"
                style="@style/Widget.DogWalk.TextInputLayout"
                android:hint="Nombre(s) *">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etFirstName"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:inputType="textPersonName|textCapWords"
                    android:fontFamily="@font/poppins"
                    android:imeOptions="actionNext"/>
            </com.google.android.material.textfield.TextInputLayout>

            <Space android:layout_width="match_parent" android:layout_height="@dimen/spacing_sm"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilLastName1"
                style="@style/Widget.DogWalk.TextInputLayout"
                android:hint="Apellido paterno *">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etLastName1"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:inputType="textPersonName|textCapWords"
                    android:fontFamily="@font/poppins"
                    android:imeOptions="actionNext"/>
            </com.google.android.material.textfield.TextInputLayout>

            <Space android:layout_width="match_parent" android:layout_height="@dimen/spacing_sm"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilLastName2"
                style="@style/Widget.DogWalk.TextInputLayout"
                android:hint="Apellido materno *">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etLastName2"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:inputType="textPersonName|textCapWords"
                    android:fontFamily="@font/poppins"
                    android:imeOptions="actionNext"/>
            </com.google.android.material.textfield.TextInputLayout>

            <Space android:layout_width="match_parent" android:layout_height="@dimen/spacing_md"/>

            <!-- Sección contacto -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONTACTO"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_xs"
                android:letterSpacing="0.12"
                android:fontFamily="@font/poppins"
                android:layout_marginBottom="@dimen/spacing_sm"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilEmail"
                style="@style/Widget.DogWalk.TextInputLayout"
                android:hint="Correo electrónico *"
                app:helperText="Ejemplo: juan.perez@gmail.com">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:inputType="textEmailAddress"
                    android:fontFamily="@font/poppins"
                    android:imeOptions="actionNext"/>
            </com.google.android.material.textfield.TextInputLayout>

            <Space android:layout_width="match_parent" android:layout_height="@dimen/spacing_sm"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPhone"
                style="@style/Widget.DogWalk.TextInputLayout"
                android:hint="Teléfono *"
                app:helperText="Ejemplo: 272-256-7654">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPhone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:inputType="phone"
                    android:maxLength="12"
                    android:fontFamily="@font/poppins"
                    android:imeOptions="actionNext"/>
            </com.google.android.material.textfield.TextInputLayout>

            <Space android:layout_width="match_parent" android:layout_height="@dimen/spacing_md"/>

            <!-- Sección seguridad -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SEGURIDAD"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_xs"
                android:letterSpacing="0.12"
                android:fontFamily="@font/poppins"
                android:layout_marginBottom="@dimen/spacing_sm"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilBirthDate"
                style="@style/Widget.DogWalk.TextInputLayout"
                android:hint="Fecha de nacimiento *"
                app:helperText="Toca para seleccionar fecha"
                app:endIconMode="custom"
                app:endIconDrawable="@android:drawable/ic_menu_my_calendar">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etBirthDate"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:cursorVisible="false"
                    android:fontFamily="@font/poppins"
                    android:inputType="none"/>
            </com.google.android.material.textfield.TextInputLayout>

            <Space android:layout_width="match_parent" android:layout_height="@dimen/spacing_sm"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPassword"
                style="@style/Widget.DogWalk.TextInputLayout"
                android:hint="Contraseña *"
                app:helperText="Mínimo 6 caracteres"
                app:endIconMode="password_toggle">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:inputType="textPassword"
                    android:fontFamily="@font/poppins"
                    android:imeOptions="actionDone"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Tarjeta (solo paseador) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCardNumber"
                style="@style/Widget.DogWalk.TextInputLayout"
                android:hint="Número de tarjeta *"
                app:helperText="Ejemplo: 1234-5678-9012-3456"
                android:visibility="gone">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCardNumber"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:inputType="number"
                    android:maxLength="19"
                    android:fontFamily="@font/poppins"
                    android:imeOptions="actionDone"/>
            </com.google.android.material.textfield.TextInputLayout>

            <Space android:layout_width="match_parent" android:layout_height="@dimen/spacing_xl"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegister"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                app:cornerRadius="@dimen/button_radius"
                android:backgroundTint="@color/primary"
                android:textColor="@color/surface"
                android:text="Crear cuenta"
                android:textSize="@dimen/text_body"
                android:textStyle="bold"
                android:fontFamily="@font/poppins"
                android:textAllCaps="false"
                android:layout_marginBottom="@dimen/spacing_md"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="¿Ya tienes cuenta? "
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_sm"
                    android:fontFamily="@font/poppins"/>

                <TextView
                    android:id="@+id/tvGoLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Inicia sesión"
                    android:textColor="@color/primary"
                    android:textSize="@dimen/text_sm"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins"
                    android:padding="@dimen/spacing_xs"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>