<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_track_walk.xml
  IDs: tvStatus, tvWalkerName, tvDogInfo, mapView
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Header naranja -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary">

        <View
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="-60dp"
            android:layout_marginEnd="-40dp"
            android:background="@drawable/circle_white_alpha"
            android:alpha="0.15"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🐾 Seguimiento en vivo"
                android:textColor="#AAFFFFFF"
                android:textSize="12sp"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏳ Esperando paseador..."
                android:textColor="@color/surface"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <!-- Info del paseador y perro -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="10dp"
                android:baselineAligned="false">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvWalkerName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Paseador: —"
                        android:textColor="#CCFFFFFF"
                        android:textSize="13sp"/>

                    <TextView
                        android:id="@+id/tvDogInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#AAFFFFFF"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>

                <!-- Indicador de señal en vivo -->
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipLive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● EN VIVO"
                    android:textSize="10sp"
                    android:textColor="@color/surface"
                    android:clickable="false"
                    android:visibility="gone"
                    app:chipBackgroundColor="#CC2D6A4F"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Mapa OSMDroid ocupa el resto de la pantalla -->
    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

</LinearLayout>