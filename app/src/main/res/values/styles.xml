<resources>

    <style name="Theme.DogWalk" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">#1B3A6B</item>
        <item name="colorPrimaryDark">#122850</item>
        <item name="colorPrimaryVariant">#122850</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#3DBFA8</item>
        <item name="colorSecondaryVariant">#2A9D8F</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="android:colorBackground">#D6E8F5</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#1B3A6B</item>
        <item name="android:statusBarColor">#122850</item>
        <item name="colorError">#E53935</item>
        <item name="android:textColor">#1B3A6B</item>
        <item name="android:textColorPrimary">#1B3A6B</item>
        <item name="android:textColorSecondary">#3A5A8A</item>
        <item name="android:textColorHint">#8AAAC8</item>
        <item name="android:editTextColor">#1B3A6B</item>
        <item name="android:windowBackground">#D6E8F5</item>
        <item name="editTextStyle">@style/Widget.DogWalk.EditText</item>
        <item name="android:fontFamily">@font/poppins</item>
    </style>

    <style name="Widget.DogWalk.EditText"
        parent="Widget.MaterialComponents.TextInputEditText.OutlinedBox">
        <item name="android:textColor">#1B3A6B</item>
        <item name="android:textColorHint">#8AAAC8</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:fontFamily">@font/poppins</item>
    </style>

    <style name="DogWalk_DatePickerDialog"
        parent="Theme.MaterialComponents.Light.Dialog">
        <item name="colorPrimary">#1B3A6B</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#1B3A6B</item>
        <item name="android:textColor">#1B3A6B</item>
        <item name="android:windowBackground">#FFFFFF</item>
        <item name="buttonBarPositiveButtonStyle">@style/DogWalk_DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/DogWalk_DialogButton</item>
    </style>

    <style name="DogWalk_DialogButton"
        parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">#1B3A6B</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.DogWalk.TextInputLayout"
        parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">#1B3A6B</item>
        <item name="boxStrokeWidth">1.5dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="hintTextColor">#1B3A6B</item>
        <item name="android:textColorHint">#8AAAC8</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#1B3A6B</item>
        <item name="boxBackgroundColor">#FFFFFF</item>
    </style>

    <style name="Widget.DogWalk.Button.Primary"
        parent="Widget.MaterialComponents.Button">
        <item name="android:backgroundTint">#1B3A6B</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="cornerRadius">28dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/poppins</item>
    </style>

</resources>