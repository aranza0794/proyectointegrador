<resources>

    <!-- ── TEMA PRINCIPAL ── -->
    <style name="Theme.DogWalk" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/surface</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryVariant">@color/accent</item>
        <item name="colorOnSecondary">@color/surface</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="colorError">@color/error</item>
        <!-- Tipografía global -->
        <item name="android:fontFamily">@font/poppins</item>
        <!-- Espaciado en listas -->
        <item name="android:listPreferredItemPaddingStart">@dimen/screen_margin</item>
        <item name="android:listPreferredItemPaddingEnd">@dimen/screen_margin</item>
    </style>

    <!-- ── TIPOGRAFÍA ── -->
    <style name="TextAppearance.DogWalk.Display" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:textColor">@color/surface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.DogWalk.Title" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:textSize">@dimen/text_xxl</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.DogWalk.Subtitle" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:textSize">@dimen/text_lg</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.DogWalk.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.DogWalk.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:textSize">@dimen/text_sm</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.DogWalk.Label" parent="TextAppearance.MaterialComponents.Overline">
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:textSize">@dimen/text_xs</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:letterSpacing">0.1</item>
    </style>

    <!-- ── INPUTS ── -->
    <style name="Widget.DogWalk.TextInputLayout"
        parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/primary</item>
        <item name="boxStrokeWidth">1.5dp</item>
        <item name="boxCornerRadiusTopStart">@dimen/input_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/input_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/input_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/input_radius</item>
        <item name="hintTextColor">@color/primary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="helperTextTextColor">@color/text_hint</item>
        <item name="android:layout_marginBottom">@dimen/input_margin_bottom</item>
    </style>

    <!-- ── BOTONES ── -->
    <style name="Widget.DogWalk.Button.Primary"
        parent="Widget.MaterialComponents.Button">
        <item name="android:backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/surface</item>
        <item name="cornerRadius">@dimen/button_radius</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:fontFamily">@font/poppins</item>
    </style>

    <style name="Widget.DogWalk.Button.Secondary"
        parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/primary</item>
        <item name="android:textColor">@color/primary</item>
        <item name="cornerRadius">@dimen/button_radius</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:fontFamily">@font/poppins</item>
    </style>

    <!-- ── TARJETAS ── -->
    <style name="Widget.DogWalk.Card"
        parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="contentPadding">@dimen/card_padding</item>
    </style>

    <!-- ── CHIPS ── -->
    <style name="Widget.DogWalk.Chip"
        parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/primary_ultra_light</item>
        <item name="chipStrokeColor">@color/primary</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/primary_dark</item>
        <item name="checkedIconTint">@color/primary</item>
        <item name="android:fontFamily">@font/poppins</item>
    </style>

    <!-- ── TOOLBAR ── -->
    <style name="Widget.DogWalk.Toolbar" parent="Widget.MaterialComponents.Toolbar.Primary">
        <item name="android:background">@color/primary</item>
        <item name="titleTextColor">@color/surface</item>
        <item name="titleTextAppearance">@style/TextAppearance.DogWalk.Subtitle</item>
    </style>

</resources>