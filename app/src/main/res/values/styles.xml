<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Tema base de la app -->
    <style name="Theme.DogWalk" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/surface</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:navigationBarColor">@color/surface</item>
    </style>

    <!-- Tema sin ActionBar para Splash -->
    <style name="Theme.DogWalk.Splash" parent="Theme.DogWalk">
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- ─── BOTONES ──────────────────────────────── -->

    <style name="Widget.DogWalk.Button.Primary">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/btn_height</item>
        <item name="android:backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/surface</item>
        <item name="android:textSize">@dimen/text_md</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/radius_full</item>
        <item name="elevation">2dp</item>
    </style>

    <style name="Widget.DogWalk.Button.Secondary">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/btn_height</item>
        <item name="android:backgroundTint">@color/surface_alt</item>
        <item name="android:textColor">@color/primary_dark</item>
        <item name="android:textSize">@dimen/text_md</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/radius_full</item>
        <item name="elevation">0dp</item>
        <item name="strokeColor">@color/primary</item>
        <item name="strokeWidth">1.5dp</item>
    </style>

    <style name="Widget.DogWalk.Button.Danger">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/btn_height</item>
        <item name="android:backgroundTint">@color/error</item>
        <item name="android:textColor">@color/surface</item>
        <item name="android:textSize">@dimen/text_md</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/radius_full</item>
    </style>

    <style name="Widget.DogWalk.Button.Success">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/btn_height</item>
        <item name="android:backgroundTint">@color/accent</item>
        <item name="android:textColor">@color/surface</item>
        <item name="android:textSize">@dimen/text_md</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/radius_full</item>
    </style>

    <!-- ─── CAMPOS DE TEXTO ──────────────────────── -->

    <style name="Widget.DogWalk.TextInputLayout">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="boxBackgroundMode">outline</item>
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="boxCornerRadiusTopStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_md</item>
        <item name="boxStrokeColor">@color/border</item>
        <item name="boxStrokeWidth">1.5dp</item>
        <item name="hintTextColor">@color/text_secondary</item>
    </style>

    <!-- ─── TEXTOS ───────────────────────────────── -->

    <style name="Widget.DogWalk.Text.Hero">
        <item name="android:textSize">@dimen/text_hero</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineSpacingMultiplier">1.1</item>
    </style>

    <style name="Widget.DogWalk.Text.Title">
        <item name="android:textSize">@dimen/text_xxl</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.DogWalk.Text.Subtitle">
        <item name="android:textSize">@dimen/text_lg</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="Widget.DogWalk.Text.Body">
        <item name="android:textSize">@dimen/text_md</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Widget.DogWalk.Text.Caption">
        <item name="android:textSize">@dimen/text_sm</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Widget.DogWalk.Text.Link">
        <item name="android:textSize">@dimen/text_md</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- ─── TARJETAS ─────────────────────────────── -->

    <style name="Widget.DogWalk.Card">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">@dimen/radius_lg</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="contentPadding">@dimen/spacing_md</item>
    </style>

    <style name="Widget.DogWalk.Card.Accent">
        <item name="cardBackgroundColor">@color/surface_alt</item>
        <item name="cardCornerRadius">@dimen/radius_lg</item>
        <item name="cardElevation">0dp</item>
        <item name="contentPadding">@dimen/spacing_md</item>
    </style>

</resources>